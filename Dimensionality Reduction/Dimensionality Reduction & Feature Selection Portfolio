# 1. Sum the votes across LassoCV, Random Forest, and Gradient Boosting masks
votes = np.sum([lcv_mask, rf_mask, gb_mask], axis=0)

# 2. Create a meta-mask for features selected by all 3 models
meta_mask = votes == 3

# 3. Apply dimensionality reduction on dataset X
X_reduced = X.loc[:, meta_mask]

# 4. Train and evaluate a linear regression pipeline on the reduced dataset
X_train, X_test, y_train, y_test = train_test_split(X_reduced, y, test_size=0.3, random_state=0)
scaler = StandardScaler()

