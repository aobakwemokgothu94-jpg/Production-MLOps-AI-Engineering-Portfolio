💻 Code Implementation
Python
# Import Required Packages
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

# 1. Load and inspect the dataset
penguins_df = pd.read_csv("penguins.csv")
print("Initial Data Shape:", penguins_df.shape)

# Drop missing values to ensure clean data for scaling and clustering
penguins_df = penguins_df.dropna()

# 2. Pre-process the dataset: Create dummy variables for categorical columns (sex)
penguins_clean = pd.get_dummies(penguins_df, drop_first=True, dtype=int)

# 3. Scale the features using StandardScaler
scaler = StandardScaler()
penguins_scaled = scaler.fit_transform(penguins_clean)
penguins_preprocessed = pd.DataFrame(penguins_scaled, columns=penguins_clean.columns)

# 4. Perform K-Means Clustering (k=4 clusters)
kmeans = KMeans(n_clusters=4, random_state=42, n_init=10)
kmeans.fit(penguins_preprocessed)

# Assign cluster labels back to the dataframe
penguins_df['label'] = kmeans.labels_

# 5. Create `stat_penguins` summarizing the mean of numeric variables by cluster
stat_penguins = penguins_df.groupby('label').mean(numeric_only=True)

# Display the resulting summary table
print(stat_penguins)
